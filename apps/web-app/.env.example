# Database (required for event store and GET /api/health)
# Local Docker: postgresql://store_checkout:store_checkout@localhost:5432/store_checkout
DATABASE_URL=postgresql://store_checkout:store_checkout@localhost:5432/store_checkout

# App
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Los_Angeles

# Logging — JSON to stdout; optional Axiom when AXIOM_* set (see apps/web-app/src/lib/logger.ts)
# Levels: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Maintenance mode (redirects to /maintenance except /api/health)
# MAINTENANCE_MODE=false

# Optional: dev user id for local testing without auth (see docs/TEMPLATE.md)
# DEV_USER_ID=

# Axiom (structured logs — optional; env-gated on Vercel Production)
AXIOM_TOKEN=
AXIOM_DATASET=
# AXIOM_FORCE_SELF_HOSTED=

# Sentry (errors — optional; no-op without DSN)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
