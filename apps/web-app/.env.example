# Database (required)
# Local Docker: postgresql://em_slices:em_slices@localhost:5432/em_slices
DATABASE_URL=postgresql://em_slices:em_slices@localhost:5432/em_slices

# App
APP_BASE_URL=http://localhost:3000
DEFAULT_TIMEZONE=America/Sao_Paulo

# Logging: trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# Maintenance mode (redirects to /maintenance except /api/health)
# MAINTENANCE_MODE=false

# Optional: dev user id for local testing without auth (see docs/TEMPLATE.md)
# DEV_USER_ID=

# Axiom (structured logs — optional; env-gated on Vercel Production)
AXIOM_TOKEN=
AXIOM_DATASET=
# AXIOM_FORCE_SELF_HOSTED=

# Sentry (errors — optional; no-op without DSN)
NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
