  },
  "devDependencies": {
    "@em-slices/tsconfig": "workspace:*",
    "typescript": "^5",
    "vitest": "^2.0.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0"
  }
}
